{
  "name": "lernfreunde",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lernfreunde – Lesen, Rechnen, Malen und Basteln für Kinder, barrierearm bedienbar",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "voice": "node scripts/generate-voice.mjs",
    "voice:check": "node scripts/generate-voice.mjs --dry-run",
    "test:rules": "firebase emulators:exec --only firestore --project lernfreunde-test \"node --test tests/rules.test.mjs\"",
    "cap:sync": "npm run build && npx cap sync"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^14.27.0",
    "sharp": "^0.33.5",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/andika": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "firebase": "^11.10.0"
  }
}
